{
  "name": "webrobot-training-studio",
  "version": "0.1.0",
  "description": "WebRobot Training Studio — host-agnostic React wizard to fine-tune small models on your data (external dataset or generated via ETL).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/client.d.ts", "import": "./dist/client.js" }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "lucide-react": ">=0.400"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/react": "^18",
    "lucide-react": "^0.400"
  },
  "keywords": ["webrobot", "fine-tuning", "training", "llm", "etl", "huggingface", "togetherai", "react", "wizard"],
  "repository": { "type": "git", "url": "git+https://github.com/WebRobot-Ltd/webrobot-training-studio.git" },
  "sideEffects": false
}
